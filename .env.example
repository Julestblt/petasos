VITE_HERMES_BASE_URL=http://127.0.0.1:8642
VITE_HERMES_API_KEY=petasos-local-dev-token
VITE_HERMES_MODEL=hermes-agent
VITE_OPERATOR_NAME=Jules
VITE_OPERATOR_ROLE=humain

# Optional local Ollama probe (leave unset/empty for remote Hermes)
# VITE_OLLAMA_BASE_URL=http://127.0.0.1:11434

# Glances host metrics (JWT via /token, Basic Auth fallback)
# VITE_HOST_METRICS_URL=https://homelab.tail042a16.ts.net:8443/api/4
# VITE_HOST_METRICS_USERNAME=cockpit
# VITE_HOST_METRICS_PASSWORD=change-me

# Codex quotas exporter (Bearer key from /root/.codex-usage-exporter.env)
# VITE_CODEX_USAGE_URL=https://homelab.tail042a16.ts.net:8444/v1/codex/usage
# VITE_CODEX_USAGE_TOKEN=change-me

# OpenCode Go quotas (Bearer sk-opencode-… from OpenCode account)
# VITE_OPENCODE_GO_API_KEY=sk-opencode-change-me
# Optional override (defaults to https://opencode.ai/zen/go/v1/usage)
# VITE_OPENCODE_GO_USAGE_URL=https://opencode.ai/zen/go/v1/usage
