# Unique dashboard API via Tailscale Serve → homelab-gateway
VITE_GATEWAY_BASE_URL=https://homelab.tail042a16.ts.net

VITE_OPERATOR_NAME=Jules
VITE_OPERATOR_ROLE=humain

# Desktop/runtime secret only. Never rename to VITE_* (Vite would embed it in the bundle).
# Copy from the host client env (e.g. /root/.homelab-gateway-client.env).
GATEWAY_API_KEY=replace-with-gateway-client-key
